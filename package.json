{
  "name": "pagenest",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Free, offline-first PWA for e-books, PDFs and audiobooks.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests && playwright test -c src/features/player/e2e/playwright.config.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "icons": "node scripts/pwa/generate-icons.mjs",
    "validate:pwa": "node scripts/pwa/validate-pwa-assets.mjs",
    "test:e2e:library": "playwright test -c src/features/library/e2e/playwright.config.mjs",
    "test:e2e:sw": "playwright test -c src/sw/e2e/playwright.config.mjs",
    "audit": "node scripts/audit-all.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs --check"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "mp4box": "^2.4.1",
    "music-metadata": "^12.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7",
    "workbox-build": "^7.4.1"
  }
}
