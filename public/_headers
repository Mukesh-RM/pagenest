# Fingerprinted Vite output never changes for a given name (no document CSP/COOP here).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Self-hosted fonts and icons are not fingerprinted by name: revalidate daily, the service worker precaches them anyway.
/fonts/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400

# The service worker and its registration inputs must never be served stale, or updates stop reaching users.
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600
/models/*
  Cache-Control: public, max-age=31536000, immutable

/ort/*
  Cache-Control: public, max-age=31536000, immutable
