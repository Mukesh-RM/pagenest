# Cloudflare Pages custom headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Served from the root of the build output (dist/_headers), copied from public/.
#
# CSP rationale (blueprint 11, 12.2, 14, 17):
#   default-src 'self'            no third-party origin anywhere; fonts, icons and all code are self-hosted
#   script-src 'self' 'wasm-unsafe-eval'   Vite bundles; WebAssembly (pdf.js, ONNX Runtime Web) must compile. No inline scripts, no eval.
#   worker-src 'self' blob:       Comlink workers are bundled files; blob: covers libraries that spawn blob workers
#   style-src 'self' 'unsafe-inline' blob:  Radix and e-book iframes inject <style> elements; the e-book engine links blob: stylesheets; no external CSS
#   img-src 'self' blob: data:    covers and book images are object URLs / data URIs from OPFS
#   media-src 'self' blob:        the single <audio> element plays object URLs created from OPFS files
#   font-src 'self'               Inter, Literata etc. are self-hosted woff2
#   connect-src 'self' blob: data:  Piper voice ONNX + config are same-origin (/models/piper/…); no runtime Hugging Face
#   frame-src 'self' blob:        foliate-js renders book sections in blob: iframes
#   manifest-src 'self'           web app manifest
#   object-src 'none'; base-uri 'self'; form-action 'self'   (the Web Share Target POSTs to /share-target on this origin)
#   frame-ancestors 'none'        the app cannot be embedded

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' blob:; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self'; connect-src 'self' blob: data:; frame-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

# No Cache-Control on /*: Cloudflare MERGES the headers of every matching rule, so a global value would be
# joined with the specific ones below and conflict. Pages already revalidates static files by default.

# Fingerprinted Vite output never changes for a given name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts and icons are not fingerprinted by name: revalidate daily, the service worker precaches them anyway.
/fonts/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400

# The service worker and its registration inputs must never be served stale, or updates stop reaching users.
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

/models/*
  Cache-Control: public, max-age=31536000, immutable
